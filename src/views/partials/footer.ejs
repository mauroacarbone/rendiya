<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="logo-word" style="color:#fff">Rendi<span>Ya</span></p>
      <p>Alquiler de autos y motos para el examen práctico de conducir en CABA y GBA.</p>
      <p>Turnos coordinados con las sedes de emisión. No es un rent-a-car por día.</p>
    </div>
    <div>
      <p><strong>Sitio</strong></p>
      <p><a href="/">Inicio</a></p>
      <p><a href="/products">Catálogo</a></p>
      <% if (user) { %>
        <p><a href="/users/reservations">Mis reservas</a></p>
        <p><a href="/users/profile">Mi perfil</a></p>
        <% if (isAdmin) { %>
          <p><a href="<%= dashboardUrl %>">Panel de operaciones</a></p>
          <p><a href="/products/create">Cargar vehículo</a></p>
          <p><a href="/products/baja">Gestionar flota</a></p>
        <% } %>
        <p><a href="/users/logout">Salir</a></p>
      <% } else { %>
        <p><a href="/users/register">Registro</a></p>
        <p><a href="/users/login">Ingresar</a></p>
      <% } %>
    </div>
    <div>
      <p><strong>Examen práctico</strong></p>
      <p>Unidades con VTV y seguro de examen.</p>
      <p>Contacto: hola@rendiya.ar</p>
      <p><a href="https://wa.me/<%= whatsappPhone %>" target="_blank" rel="noopener">WhatsApp</a></p>
    </div>
  </div>
</footer>
<div class="wa-widget">
  <div class="wa-popup" id="wa-popup" hidden>
    <button type="button" class="wa-close" id="wa-close" aria-label="Cerrar">×</button>
    <p class="wa-popup-title">RendiYa</p>
    <p>Escribinos por cualquier consulta sobre tu turno.</p>
    <a class="btn btn-rojo wa-open" href="https://wa.me/<%= whatsappPhone %>?text=<%= encodeURIComponent('Hola RendiYa, quiero consultar por un turno.') %>" target="_blank" rel="noopener">Abrir WhatsApp</a>
  </div>
  <button type="button" class="wa-fab" id="wa-fab" aria-label="Abrir chat de WhatsApp">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="#fff" d="M20.5 3.5A11 11 0 0 0 2.1 17.8L1 23l5.3-1.4A11 11 0 0 0 12 23a11 11 0 0 0 8.5-19.5zM12 21a9 9 0 0 1-4.6-1.3l-.3-.2-3.1.8.8-3-.2-.3A9 9 0 1 1 12 21zm5-6.7c-.3-.1-1.6-.8-1.8-.9s-.4-.1-.6.1-.7.9-.8 1-.3.2-.6.1a7.3 7.3 0 0 1-2.2-1.3 8 8 0 0 1-1.5-1.9c-.2-.3 0-.4.1-.6l.4-.4.3-.4c.1-.2 0-.3 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3s-1 1-1 2.4 1 2.8 1.2 3a10.4 10.4 0 0 0 4 3.4c.6.2 1 .4 1.4.5a3.3 3.3 0 0 0 1.5.1c.5-.1 1.6-.6 1.8-1.3s.2-1.2.2-1.3-.2-.2-.4-.3z"/></svg>
  </button>
</div>
<script src="/js/whatsapp.js"></script>
