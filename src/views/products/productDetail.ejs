<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>
  <main class="wrap detalle">
    <div class="galeria">
      <p><a href="/">Inicio</a> / <a href="/products">Vehículos</a> / <%= product.name %></p>
      <img src="<%= product.image %>" alt="<%= product.name %>" />
    </div>
    <aside class="panel">
      <span class="tag"><%= product.category %> · <%= product.zone %> · <%= product.license %></span>
      <h1><%= product.name %></h1>
      <p><%= product.description %></p>
      <p class="precio">$<%= product.price.toLocaleString('es-AR') %> por turno</p>
      <ul class="lista">
        <li>Color: <%= product.colors %></li>
        <li>Transmisión: <%= product.transmission %></li>
        <li>VTV: <%= product.vtv ? 'Vigente' : 'A confirmar' %></li>
        <li>Seguro de examen: <%= product.insurance ? 'Incluido' : 'No incluido' %></li>
        <li>Rinde en: <%= venue.name %></li>
      </ul>
      <div class="venue-box">
        <p class="venue-name"><%= venue.name %></p>
        <p class="hint"><%= venue.address %></p>
        <% if (venue.requirements && venue.requirements.length) { %>
          <p class="venue-label">Requisitos de la sede</p>
          <ul class="venue-reqs">
            <% venue.requirements.forEach(function (item) { %><li><%= item %></li><% }) %>
          </ul>
        <% } %>
      </div>
      <form action="/products/cart" method="get">
        <input type="hidden" name="id" value="<%= product.id %>" />
        <input type="hidden" name="instructor" value="0" />
        <div class="campo">
          <label for="fecha">Fecha del examen</label>
          <input id="fecha" type="date" name="fecha" />
        </div>
        <div class="campo">
          <label for="franja">Franja horaria</label>
          <select id="franja" name="franja">
            <% (venue.slots || []).forEach(function (slot) { %>
              <option><%= slot %></option>
            <% }) %>
          </select>
        </div>
        <label class="check"><input type="checkbox" name="instructor" value="1" data-instructor-toggle /> Instructor acompañante (+$15.000)</label>
        <input type="hidden" name="pickup" value="0" />
        <label class="check">
          <input type="checkbox" name="pickup" value="1" />
          Que el instructor me retire por casa (taxímetro CABA)
        </label>
        <div class="pickup-fields" hidden>
          <div class="campo">
            <label for="pickup_address">Dirección de retiro</label>
            <input id="pickup_address" name="pickup_address" type="text" placeholder="Calle, barrio y localidad" />
          </div>
          <div class="campo">
            <label for="pickup_km">Km estimados hasta el centro de emisión</label>
            <input id="pickup_km" name="pickup_km" type="number" min="1" max="80" step="1" value="<%= product.zone === 'GBA' ? 14 : 5 %>" />
            <p class="hint">Se cobra bajada de bandera + fichas cada 200 m, según tarifa oficial de taxi CABA.</p>
          </div>
        </div>
        <p><button class="btn btn-rojo" type="submit">Reservar turno</button></p>
      </form>
      <% if (isAdmin) { %>
        <p>
          <a class="btn btn-linea" href="/products/<%= product.id %>/edit">Editar vehículo</a>
        </p>
        <form action="/products/<%= product.id %>?_method=DELETE" method="post" data-confirm="¿Eliminar este vehículo?" data-confirm-text="<%= product.name %> se saca de la flota." data-icon="warning" data-confirm-yes="Eliminar" data-confirm-no="Volver">
          <input type="hidden" name="_method" value="DELETE" />
          <button class="btn btn-linea" type="submit">Eliminar</button>
        </form>
      <% } %>
    </aside>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/booking-extras.js"></script>
</body>
</html>
