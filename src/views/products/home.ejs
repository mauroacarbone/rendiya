<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>

  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">CABA y GBA · Auto o moto</span>
        <h1>Reservá el vehículo para tu examen práctico</h1>
        <p>Turnos cortos, unidades aptas para el práctico y cerca del centro de emisión.</p>
        <form class="filtros" action="/products" method="get">
          <select name="category" aria-label="Tipo de vehículo">
            <option value="">Todos</option>
            <option value="Auto">Auto</option>
            <option value="Moto">Moto</option>
          </select>
          <select name="sede" aria-label="Sede de examen">
            <option value="">Todas las sedes</option>
            <% venueList.forEach(function (venue) { %>
              <option value="<%= venue.slug %>"><%= venue.name %> (<%= venue.zone %>)</option>
            <% }) %>
          </select>
          <input type="date" name="fecha" aria-label="Fecha del examen" />
          <button class="btn btn-rojo" type="submit">Ver disponibilidad</button>
        </form>
      </div>
      <div class="hero-photo">
        <img src="/images/fazer600.jpg" alt="Yamaha Fazer lista para el examen práctico" />
      </div>
    </div>
  </section>

  <section class="seccion" id="oferta">
    <div class="wrap">
      <h2>Destacados</h2>
      <p>Unidades habilitadas para el práctico. El precio es por franja, no por día.</p>
      <div class="grid-prod">
        <% destacados.forEach(function (product) { %>
          <%- include('../partials/productCard', { product }) %>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="wrap">
      <h2>Unidades en CABA</h2>
      <div class="grid-prod">
        <% caba.forEach(function (product) { %>
          <%- include('../partials/productCard', { product }) %>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="wrap">
      <h2>Unidades en GBA</h2>
      <div class="grid-prod">
        <% if (gba.length) { %>
          <% gba.forEach(function (product) { %>
            <%- include('../partials/productCard', { product }) %>
          <% }) %>
        <% } else { %>
          <section class="empty-state">
            <p>Todavía no hay unidades publicadas en GBA.</p>
          </section>
        <% } %>
      </div>
    </div>
  </section>

  <section class="seccion" id="como">
    <div class="wrap">
      <h2>Cómo funciona</h2>
      <div class="pasos">
        <article class="paso"><strong>1. Elegí</strong><p>Auto o moto, CABA o GBA, y la fecha de tu práctico.</p></article>
        <article class="paso"><strong>2. Reservá</strong><p>Sumá extras (instructor, casco) y confirmá el turno desde el carrito.</p></article>
        <article class="paso"><strong>3. Rendí</strong><p>Retirás la unidad cerca del centro de emisión.</p></article>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="wrap">
      <div class="quiz-cta">
        <h2>Practicá la teoría gratis</h2>
        <p>Simulador con preguntas de señales, prioridades y velocidades de CABA y GBA. Cronometrado, como el examen real.</p>
        <a class="btn btn-rojo" href="/simulador">Hacer el simulacro</a>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
