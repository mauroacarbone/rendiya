<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>
  <main class="wrap checkout-page">
    <section class="auth pay-box">
      <h1>Pago aprobado</h1>
      <p class="notice-soft">La pasarela acreditó el turno. No se realizó un cobro real.</p>
      <p>Tu reserva<%= product ? ' para el ' + product.name : '' %> quedó <strong>confirmada</strong>.</p>
      <p><strong><%= date %></strong> · <%= time_slot %></p>
      <% if (typeof examCenter !== 'undefined' && examCenter) { %>
        <p>Sede: <strong><%= examCenter.name %></strong> · <%= examCenter.address %></p>
      <% } %>
      <% if (typeof assignment !== 'undefined' && assignment && (assignment.assigned_vehicle || assignment.assigned_instructor)) { %>
        <p class="notice-ok">
          Asignación automática:
          <% if (assignment.assigned_vehicle) { %><strong><%= assignment.assigned_vehicle %></strong><% } %>
          <% if (assignment.assigned_instructor) { %> con <strong><%= assignment.assigned_instructor %></strong><% } %>.
        </p>
      <% } %>
      <% if (typeof totals !== 'undefined' && totals) { %>
        <% if (totals.addons.length) { %>
          <p>Extras: <%= totals.addons.map(function (addon) { return addon.label; }).join(', ') %>.</p>
        <% } %>
        <p>Total del turno: <strong>$<%= totals.total.toLocaleString('es-AR') %></strong></p>
        <% if (typeof payment !== 'undefined' && payment) { %>
          <p>Pago: <%= payment.label %><%= payment.last4 ? ' •••• ' + payment.last4 : '' %>.</p>
        <% } %>
        <% if (booking && booking.contactPhone) { %>
          <p>Te vamos a escribir a <strong><%= user ? user.email : '' %></strong> y al WhatsApp <strong><%= booking.contactPhone %></strong> para terminar de coordinar el servicio.</p>
        <% } %>
        <% if (booking && booking.pickup) { %>
          <p>Retiro<%= booking.pickupAddress ? ' en ' + booking.pickupAddress : '' %> (<%= Number(booking.pickupKm).toFixed(1) %> km hasta la sede<% if (typeof examCenter !== 'undefined' && examCenter) { %>: <%= examCenter.name %><% } %>).</p>
        <% } %>
      <% } %>
      <p><a class="btn btn-rojo" href="/users/reservations">Ver mis reservas</a></p>
      <p><a class="btn btn-linea" href="/products">Seguir viendo vehículos</a></p>
    </section>
  </main>
  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
  <script src="/js/reservation-share.js"></script>
  <script>
    if (window.RendiYaShare) window.RendiYaShare.celebrateConfirmed();
  </script>
</body>
</html>
