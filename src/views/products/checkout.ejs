<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>
  <main class="wrap checkout-page checkout-wide">
    <h1>Confirmar reserva</h1>
    <% if (error) { %>
      <div class="banner-error" role="alert"><%= error %></div>
    <% } %>
    <% if (!product) { %>
      <section class="empty-state">
        <p>No hay un turno en el carrito.</p>
        <p><a class="btn btn-rojo" href="/products">Ver catálogo</a></p>
      </section>
    <% } else { %>
      <form id="form-checkout" action="/products/checkout" method="post" class="checkout-grid">
        <section class="panel">
          <h2>Turno</h2>
          <p><strong><%= product.name %></strong> · <%= product.zone %></p>
          <div class="campo">
            <label for="date">Fecha del examen</label>
            <input id="date" name="date" type="date" value="<%= booking.date || '' %>" required />
          </div>
          <div class="campo">
            <label for="time_slot">Franja horaria en <%= venue.name %></label>
            <select id="time_slot" name="time_slot" required>
              <% timeSlots.forEach(function (slot) { %>
                <option value="<%= slot %>" <%= booking.time_slot === slot ? 'selected' : '' %>><%= slot %></option>
              <% }) %>
            </select>
            <p class="hint" id="slot-status">Elegí la fecha para ver el cupo de la sede.</p>
          </div>

          <div class="venue-box">
            <p class="venue-name"><%= venue.name %></p>
            <p class="hint"><%= venue.address %><%= venue.phone ? ' · ' + venue.phone : '' %></p>
            <% if (venue.requirements && venue.requirements.length) { %>
              <p class="venue-label">Qué tenés que llevar</p>
              <ul class="venue-reqs">
                <% venue.requirements.forEach(function (item) { %><li><%= item %></li><% }) %>
              </ul>
            <% } %>
          </div>
          <input type="hidden" name="instructor" value="<%= booking.instructor ? '1' : '0' %>" />
          <input type="hidden" name="pickup" id="pickup-value" value="1" />
          <label class="check">
            <input type="checkbox" id="pickup-toggle" <%= booking.pickup === false ? '' : 'checked' %> />
            Retiro a domicilio hasta la sede (obligatorio para calcular el taxímetro)
          </label>
          <p class="hint">Buscá o marcá tu casa; el costo hasta <%= venue.name %> se calcula con la ruta real.</p>

          <div id="pickup-map-wrap">
            <div class="campo">
              <label for="origin_search">Ubicación de retiro</label>
              <div class="search-row">
                <input id="origin_search" type="text" placeholder="Calle, barrio, localidad" value="<%= booking.pickupAddress || '' %>" autocomplete="off" />
                <button class="btn btn-linea" type="button" id="btn-geocode">Buscar</button>
              </div>
            </div>
            <div id="checkout-map" class="checkout-map" role="application" aria-label="Mapa de retiro"></div>
            <p class="pickup-actions">
              <button class="btn btn-rojo" type="button" id="btn-confirm-origin" hidden>Confirmar este retiro</button>
            </p>
            <p id="origin-confirmed" class="notice-ok" hidden></p>
            <iframe id="gmaps-frame" class="gmaps-frame" title="Ruta en Google Maps" src="https://www.google.com/maps?q=<%= examCenter.lat %>,<%= examCenter.lng %>&z=13&output=embed"></iframe>
            <p id="route-status" class="hint">Buscá o marcá el punto y confirmá el retiro para calcular el taxímetro.</p>
          </div>
          <input type="hidden" name="origin_lat" id="origin_lat" value="<%= booking.pickupLat || '' %>" />
          <input type="hidden" name="origin_lng" id="origin_lng" value="<%= booking.pickupLng || '' %>" />
          <input type="hidden" name="origin_address" id="origin_address" value="<%= booking.pickupAddress || '' %>" />
        </section>

        <section class="panel">
          <h2>Total</h2>
          <div id="totals-box" class="totales">
            <p><span>Vehículo</span><span id="tot-vehicle">$<%= totals.vehicle.toLocaleString('es-AR') %></span></p>
            <p><span>Instructor</span><span id="tot-instructor">$<%= totals.instructorFee.toLocaleString('es-AR') %></span></p>
            <p><span>Retiro (taxímetro)</span><span id="tot-pickup">$<%= totals.pickupFee.toLocaleString('es-AR') %></span></p>
            <p><span>Extras</span><span id="tot-addons">$<%= totals.addonsFee.toLocaleString('es-AR') %></span></p>
            <p><strong>Total</strong><strong id="tot-total">$<%= totals.total.toLocaleString('es-AR') %></strong></p>
          </div>
          <div class="addons-summary">
            <% if (totals.addons.length) { %>
              <ul>
                <% totals.addons.forEach(function (addon) { %>
                  <li><%= addon.label %> · $<%= addon.price.toLocaleString('es-AR') %></li>
                <% }) %>
              </ul>
            <% } else { %>
              <p class="hint">Sin extras. Podés sumar clase previa, simulacro teórico o seguro ampliado.</p>
            <% } %>
            <p><a href="/products/cart?id=<%= product.id %>">Editar extras</a></p>
          </div>

          <h2>Contacto para coordinar</h2>
          <p class="hint">Usamos tu email registrado (<%= user ? user.email : '' %>). Necesitamos un WhatsApp para cerrar el servicio.</p>
          <%- include('../partials/phone-field', { name: 'contact_phone', id: 'contact_phone', value: booking.contactPhone || (user && user.phone) || '', error: '' }) %>

          <h2>Forma de pago</h2>
          <p class="notice-soft">Elegí cómo vas a pagar. En el paso siguiente se abre la pasarela RendiYa Pay. No se realiza un cobro real.</p>
          <div class="pay-methods">
            <label class="pay-option"><input type="radio" name="payment_method" value="card" required /> Tarjeta</label>
            <label class="pay-option"><input type="radio" name="payment_method" value="mercadopago" /> Mercado Pago</label>
            <label class="pay-option"><input type="radio" name="payment_method" value="transfer" /> Transferencia</label>
          </div>
          <p class="hint">El turno queda pendiente hasta que la pasarela acredite el pago. Mis reservas y el dashboard se actualizan en vivo.</p>

          <button class="btn btn-rojo" type="submit" id="btn-pay">Continuar al pago</button>
        </section>
      </form>
    <% } %>
  </main>
  <%- include('../partials/footer') %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <% if (googleMapsKey) { %>
    <script src="https://maps.googleapis.com/maps/api/js?key=<%= googleMapsKey %>&libraries=places"></script>
  <% } %>
  <script>
    window.RENDIYA_CHECKOUT = {
      examCenter: <%- JSON.stringify(examCenter) %>,
      venue: <%- JSON.stringify(venue) %>,
      instructor: <%= booking.instructor ? 'true' : 'false' %>,
      hasGoogle: <%= googleMapsKey ? 'true' : 'false' %>,
      userEmail: <%- JSON.stringify(user ? user.email : '') %>
    };
  </script>
  <script src="/js/phone-input.js"></script>
  <script src="/js/checkout.js"></script>
</body>
</html>
