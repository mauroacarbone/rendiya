<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>
  <main class="wrap checkout-page">
    <section class="auth pay-box">
      <h1>Confirmar reserva</h1>
      <% if (product) { %>
        <p><strong><%= product.name %></strong> · $<%= product.price.toLocaleString('es-AR') %> por turno</p>
      <% } else { %>
        <p>Elegí fecha y franja. El turno queda registrado en tu cuenta.</p>
      <% } %>
      <% if (error) { %>
        <div class="banner-error" role="alert"><%= error %></div>
      <% } %>
      <form id="form-checkout" action="/products/checkout" method="post" class="pay-form">
        <div class="campo">
          <label for="date">Fecha del examen</label>
          <input id="date" name="date" type="date" value="<%= booking.date || '' %>" required />
        </div>
        <div class="campo">
          <label for="time_slot">Franja horaria</label>
          <select id="time_slot" name="time_slot" required>
            <option value="08:00 – 11:00" <%= booking.time_slot === '08:00 – 11:00' ? 'selected' : '' %>>08:00 – 11:00</option>
            <option value="11:00 – 14:00" <%= booking.time_slot === '11:00 – 14:00' ? 'selected' : '' %>>11:00 – 14:00</option>
            <option value="14:00 – 17:00" <%= booking.time_slot === '14:00 – 17:00' ? 'selected' : '' %>>14:00 – 17:00</option>
          </select>
        </div>
        <button class="btn btn-rojo" type="submit">Confirmar turno</button>
      </form>
    </section>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/ui.js"></script>
</body>
</html>
