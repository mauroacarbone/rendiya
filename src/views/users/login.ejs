<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>
  <main class="auth">
    <h1>Ingresar</h1>
    <p>Ingresá para confirmar tu reserva. El carrito se mantiene.</p>
    <p class="hint">Demo: <strong>demo@rendiya.ar</strong> · <strong>demo1234</strong></p>
    <% if (typeof expired !== 'undefined' && expired) { %>
      <div class="banner-error banner-wait" role="status">Tu sesión expiró. Ingresá de nuevo para continuar.</div>
    <% } %>
    <% if (errors.credentials || errors.email || errors.password) { %>
      <div class="banner-error" role="alert"><%= errors.credentials || errors.email || errors.password %></div>
    <% } %>
    <form id="form-login" action="/users/login" method="post" novalidate>
      <input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '/users/profile' %>" />
      <div class="campo <%= errors.credentials || errors.email ? 'error' : '' %>">
        <label for="email">Email</label>
        <input id="email" type="email" name="email" value="<%= old.email || '' %>" />
        <% if (errors.email && !errors.credentials) { %><p class="msg-error"><%= errors.email %></p><% } %>
      </div>
      <div class="campo <%= errors.credentials || errors.password ? 'error' : '' %>">
        <label for="password">Contraseña</label>
        <input id="password" type="password" name="password" />
        <% if (errors.password && !errors.credentials) { %><p class="msg-error"><%= errors.password %></p><% } %>
      </div>
      <label class="check">
        <input type="checkbox" name="remember" value="on" />
        Recordarme en este dispositivo
      </label>
      <p><button class="btn btn-rojo" type="submit">Ingresar</button></p>
    </form>
    <p>¿No tenés cuenta? <a href="/users/register?next=<%= encodeURIComponent(typeof next !== 'undefined' ? next : '/users/profile') %>">Registrate</a></p>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/form-validation.js"></script>
  <script src="/js/login.js"></script>
</body>
</html>
