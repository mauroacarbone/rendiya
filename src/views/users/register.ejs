<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>
  <main class="auth">
    <h1>Crear cuenta</h1>
    <p>Creá tu cuenta para guardar y gestionar tus reservas.</p>
    <% if (Object.keys(errors).length) { %>
      <div class="banner-error" role="alert">Revisá los datos marcados.</div>
    <% } %>
    <form id="form-register" action="/users/register" method="post" enctype="multipart/form-data" novalidate>
      <div class="campo <%= errors.firstName ? 'error' : '' %>">
        <label for="firstName">Nombre</label>
        <input id="firstName" name="firstName" type="text" value="<%= old.firstName || '' %>" />
        <% if (errors.firstName) { %><p class="msg-error"><%= errors.firstName %></p><% } %>
      </div>
      <div class="campo <%= errors.lastName ? 'error' : '' %>">
        <label for="lastName">Apellido</label>
        <input id="lastName" name="lastName" type="text" value="<%= old.lastName || '' %>" />
        <% if (errors.lastName) { %><p class="msg-error"><%= errors.lastName %></p><% } %>
      </div>
      <div class="campo <%= errors.email ? 'error' : '' %>">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="<%= old.email || '' %>" />
        <% if (errors.email) { %><p class="msg-error"><%= errors.email %></p><% } %>
      </div>
      <div class="campo">
        <label for="category">Categoría</label>
        <select id="category" name="category">
          <option value="client" <%= old.category === 'instructor' ? '' : 'selected' %>>Cliente</option>
          <option value="instructor" <%= old.category === 'instructor' ? 'selected' : '' %>>Instructor</option>
        </select>
      </div>
      <div class="campo <%= errors.image ? 'error' : '' %>">
        <label for="image">Foto de perfil</label>
        <input id="image" name="image" type="file" accept=".jpg,.jpeg,.png,.gif,image/jpeg,image/png,image/gif" />
        <% if (errors.image) { %><p class="msg-error"><%= errors.image %></p><% } %>
      </div>
      <div class="campo <%= errors.password ? 'error' : '' %>">
        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" />
        <p class="hint">Mínimo 8 caracteres.</p>
        <% if (errors.password) { %><p class="msg-error"><%= errors.password %></p><% } %>
      </div>
      <div class="campo <%= errors.passwordConfirm ? 'error' : '' %>">
        <label for="passwordConfirm">Repetir contraseña</label>
        <input id="passwordConfirm" name="passwordConfirm" type="password" />
        <% if (errors.passwordConfirm) { %><p class="msg-error"><%= errors.passwordConfirm %></p><% } %>
      </div>
      <p><button class="btn btn-rojo" type="submit">Registrarme</button></p>
    </form>
    <p>¿Ya tenés cuenta? <a href="/users/login">Ingresá</a></p>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/form-validation.js"></script>
  <script src="/js/register.js"></script>
</body>
</html>
